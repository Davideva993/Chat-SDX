# Backend port (default: 3001)
PORT=3001

# Comma-separated list of allowed CORS origins
# Use '*' to allow all origins (dev mode)
# Use specific origins for production (e.g. 'https://your-domain.com' or 'http://your-address.onion')
# Not needed when frontend runs as a local file (the intended setup).
ALLOWED_ORIGINS=*

# Password required to access the server challenge admin page
# Do not transmit over plain HTTP — use Tor or TLS in production.
SERVER_PASSWORD=changeme123
